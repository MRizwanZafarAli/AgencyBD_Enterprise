# AgencyBD_Enterprise Environment Configuration Template

# 1. Core System & Security
# development | test | production. Production refuses to start with missing or placeholder secrets.
AGENCYBD_ENV=development
# Fill the three secrets with:  python scripts/generate_secrets.py   (never commit real values)
AGENCYBD_JWT_SECRET=replace_me
AGENCYBD_WEBHOOK_SECRET=replace_me
AGENCYBD_HMAC_VAULT_KEY=replace_me
DB_PATH=data/agency_bd.db
# Sign-in passwords (one per tier, stored only as hashes):  python scripts/set_passwords.py
# AGENCYBD_LOGIN_ORG=org_default   # the workspace that passwords sign in to

# Browser origins allowed to call the API (comma separated, no wildcard)
AGENCYBD_CORS_ORIGINS=http://localhost:5173,http://localhost:8001
# Tenant that inbound webhook events are attributed to
AGENCYBD_WEBHOOK_ORG_ID=org_default
# Swagger UI is always on outside production; set true to expose it in production
AGENCYBD_ENABLE_DOCS=false
# Public URL of this API (used in unsubscribe links) and your legal sender identity (CAN-SPAM). Required in production.
AGENCYBD_PUBLIC_BASE_URL=http://localhost:8001
AGENCYBD_SENDER_COMPANY=Your Agency Name
AGENCYBD_SENDER_ADDRESS=

# 2. Redis & Distributed Worker
REDIS_URL=redis://localhost:6379/0

# 3. Deliverability & Sending Domain Fleet
PRIMARY_INBOX=
OUTBOUND_POOL_INBOXES=
MAX_BOUNCE_RATE_THRESHOLD=0.02
MAX_EMAILS_PER_INBOX_PER_DAY=40

# 4. Enrichment & Sourcing Vendor API Keys (Optional - Falls back to autonomous scraping)
APOLLO_API_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=

# 5. Future GTM Integrations (Optional)
RB2B_API_KEY=
RETELL_AI_API_KEY=
TAVUS_API_KEY=

# 6. CRM & Notification Webhooks
HUBSPOT_ACCESS_TOKEN=
SLACK_WEBHOOK_URL=
CAL_BOOKING_LINK=

# 7. Agency identity (quoted to prospects verbatim; leave blank rather than guess)
AGENCYBD_SENDER_NAME=
AGENCYBD_SENDER_TITLE=
AGENCYBD_BOOKING_LINK=
AGENCYBD_AGENCY_DOMAIN=
AGENCYBD_AGENCY_TAGLINE=
AGENCYBD_CORE_SERVICES=
AGENCYBD_CASE_STUDY=

# 8. Intelligence & discovery keys (each feature reports "not configured" without its key)
ANTHROPIC_API_KEY=
PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=
MILLIONVERIFIER_API_KEY=
SAM_GOV_API_KEY=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# 9. Scheduler & radar
AGENCYBD_SCHEDULER=off
AGENCYBD_SEND_WINDOW=09:00-17:00
AGENCYBD_MIN_PROJECT_BUDGET=
AGENCYBD_FIT_KEYWORDS=
GITHUB_TOKEN=            # optional: raises the GitHub bounty search rate limit
OLLAMA_HOST=             # optional: local model instead of Anthropic

# 10. Security checks and browser
NVD_API_KEY=             # optional: raises the NVD rate limit for vulnerability lookups
AGENCYBD_BROWSER_NO_SANDBOX=off   # set on only when Chrome runs as root inside a container
